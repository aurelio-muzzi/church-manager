# ChurchManager Environment Configuration Example

# Backend
APP_NAME=ChurchManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Manaus
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=churchmanager
DB_USERNAME=church_user
DB_PASSWORD=church_password

# Sanctum Statefull Domains
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
