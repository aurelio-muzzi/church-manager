# ChurchManager Frontend Environment Variables

# Base URL for API requests
VITE_API_BASE_URL=/api/v1

# Enable development mock adapter when backend is offline or during frontend development
# Set to 'true' to use typed fixtures, 'false' to communicate directly with backend API
VITE_USE_DEV_MOCK=true

# Application Name
VITE_APP_NAME=ChurchManager

# Default Timezone
VITE_DEFAULT_TIMEZONE=America/Manaus

# Development Log Level: debug | info | warn | error
VITE_LOG_LEVEL=debug
